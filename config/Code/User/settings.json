    "vim.normalModeKeyBindingsNonRecursive": [
        // Swapping , and ; since , doesn't require Shift
        { "before": [","], "after": [";"] },
        { "before": [";"], "after": [","] },
        // Fix some text-object commands with $
        { "before": ["d", "i", "$"], "after": ["T", "$", "d", "t", "$"], },
        { "before": ["c", "i", "$"], "after": ["T", "$", "c", "t", "$"], },
        { "before": ["y", "i", "$"], "after": ["T", "$", "y", "t", "$"], },
        { "before": ["d", "a", "$"], "after": ["F", "$", "d", "f", "$"], },
        { "before": ["c", "a", "$"], "after": ["F", "$", "c", "f", "$"], },
        { "before": ["y", "a", "$"], "after": ["F", "$", "y", "f", "$"], },
        { "before": ["d", "s", "$"], "after": ["F", "$", "x", "f", "$", "x"], },
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        // Allow surrounding with dollars and spaces
        { "before": ["S", "$"], "after": ["c", "$", "$", "<Esc>", "P"]},
        { "before": ["S", " "], "after": ["c", " ", " ", "<Esc>", "P"]},
        { "before": ["S", "<CR>"], "after": ["c", "<CR>", "<CR>", "<Esc>", "P"]},
