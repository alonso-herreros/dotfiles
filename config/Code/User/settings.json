    "multiCommand.commands": {
        "multiCommand.issueFromSelection": {
            "Label": "Create issue from selection",
            "interval": 30,
            "sequence": [
                "editor.action.clipboardCopyAction",

                "issue.createIssue",

                // Paste the issue body
                {"command": "cursorDown", "repeat": 6},
                "cursorBottomSelect",
                "editor.action.clipboardPasteAction",
    
                // Copy the issue title, excluding the first "word", which is the title (#) tag
                "cursorTop",
                {"command": "cursorDown", "repeat": 6},
                "cursorWordStartRight",
                "cursorEndSelect",
                "editor.action.clipboardCopyAction",
    
                // Paste the issue title
                "cursorTop",
                "cursorEndSelect",
                "editor.action.clipboardPasteAction",
    
                // Assign the issue to me
                // "cursorDown", "cursorDown",
                // "cursorEnd",
                // {"command": "type", "args": {"text": "@alonso-herreros"}}
            ]
        },
    },
