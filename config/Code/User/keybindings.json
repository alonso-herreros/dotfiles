    {
        "key": "ctrl+alt+8",
        "command": "workbench.action.focusEighthEditorGroup"
    },
    {
        "key": "ctrl+8",
        "command": "-workbench.action.focusEighthEditorGroup"
    },
    // #endregion Tab navigation

    // #region MARK: # Alt+hjkl Movement
    {
        "key": "alt+h",
        "command": "cursorLeft",
        "when": "textInputFocus && (!vim.active || vim.mode == 'Insert')"
    },
    {
        "key": "alt+l",
        "command": "cursorRight",
        "when": "textInputFocus && (!vim.active || vim.mode == 'Insert')"
    },
    {
        "key": "alt+j",
        "command": "cursorDown",
        "when": "textInputFocus && (!vim.active || vim.mode == 'Insert')"
    },
    {
        "key": "alt+k",
        "command": "cursorUp",
        "when": "textInputFocus && (!vim.active || vim.mode == 'Insert')"
    },
    { // MARK: Shift+h/l (character-wise selecting)
        "key": "alt+shift+h",
        "command": "cursorLeftSelect",
        "when": "textInputFocus && (!vim.active || vim.mode == 'Insert')"
    },
    {
        "key": "alt+shift+l",
        "command": "cursorRightSelect",
        "when": "textInputFocus && (!vim.active || vim.mode == 'Insert')"
    },
    { // MARK: QuickOpen (Command Palette, Go to, etc)
        "key": "alt+j",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    },
    {
        "key": "alt+k",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
    },
    { // MARK: Code actions
        "key": "alt+j",
        "command": "selectNextCodeAction",
        "when": "codeActionMenuVisible"
    },
    {
        "key": "alt+k",
        "command": "selectPrevCodeAction",
        "when": "codeActionMenuVisible"
    },
    { // MARK: Suggestions
        "key": "alt+j",
        "command": "selectNextSuggestion",
        "when": "suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "alt+k",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus"
    },
    { // MARK: History
        "key": "alt+j",
        "command": "history.showNext",
        "when": "historyNavigationForwardsEnabled && historyNavigationWidgetFocus && !isComposing && !suggestWidgetVisible"
    },
    {
        "key": "alt+k",
        "command": "history.showPrevious",
        "when": "historyNavigationBackwardsEnabled && historyNavigationWidgetFocus && !isComposing && !suggestWidgetVisible && !inKeybindings"
    },
    // #endregion Alt+hjkl Movement
    // #region MARK: # Alt+(shift)+hjkl Moving/copying lines
    {
        "key": "alt+j",
        "command": "editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && vim.mode != 'Insert'"
    },
    {
        "key": "alt+k",
        "command": "editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && vim.mode != 'Insert'"
    },
    {
        "key": "shift+alt+j",
        "command": "editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+alt+k",
        "command": "editor.action.copyLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    // #endregion Alt+(shift)+hjkl Moving/copying lines
    // #region MARK: # Vim-moving in Insert mode
    { // Word movements
        "key": "alt+w",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "w"] }
    },
    {
        "key": "alt+b",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "b"] }
    },
    {
        "key": "alt+e",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "e", "<C-o>", "l"] }
    },
    {
        "key": "alt+shift+w",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "W"] }
    },
    {
        "key": "alt+shift+b",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "B"] }
    },
    {
        "key": "alt+shift+e",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "E", "<C-o>", "l"] }
    },
    { // MARK: In-line movements
        "key": "alt+i",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "I"] }
    },
    {
        "key": "alt+a",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "A"] }
    }, // MARK: Quick markers
    {
        "key": "alt+m",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "m", "`"] }
    },
    {
        "key": "alt+oem_1",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "`", "`"] }
    },
    { // MARK: Newlines
        "key": "alt+o",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "o"] }
    },
    {
        "key": "alt+shift+o",
        "command": "vim.remap",
        "when": "editorTextFocus && vim.mode == 'Insert'",
        "args": { "after": ["<C-o>", "O"] }
    },
    // #endregion Vim-moving in Isert mode

    // #region MARK: # Folding
    {
        "key": "ctrl+alt+n",
        "command": "-code-runner.run"
    },
    {
        "key": "ctrl+enter",
        "command": "code-runner.run",
        "when": "editorTextFocus && !notebookEditorFocused && editorLangId != 'matlab' && resourceScheme != 'newIssue' && acceptSuggestionOnEnter != 'newIssue'"
    },
    {
        "key": "ctrl+enter",
        "command": "matlab-interactive-terminal.runMatlabScript",
        "when": "editorTextFocus && editorLangId == 'matlab' && !editorHasSelection"
    },
    {
        "key": "ctrl+enter",
        "command": "testing.runAtCursor",
        "when": "editorTextFocus && testing.activeEditorHasTests"
    },
    {
        "key": "ctrl+enter",
        "command": "git.commit",
        "when": "editorLangId == 'scminput'"
    },
    {
        "key": "ctrl+k ctrl+shift+enter",
        "command": "jupyter.runallcellsabove.palette",
        "when": "editorTextFocus && isWorkspaceTrusted && jupyter.hascodecells && !editorHasSelection && !jupyter.havenativecells && !notebookEditorFocused"
    },
    {
        "key": "ctrl+k ctrl+enter",
        "command": "jupyter.notebookeditor.runallcells",
        "when": "editorTextFocus && isWorkspaceTrusted && jupyter.hascodecells && !editorHasSelection && !jupyter.havenativecells && !notebookEditorFocused"
    },
    // #endregion

    // #region MARK: # Markdown Math (LaTeX)
    {
        "key": "ctrl+m",
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown' && editorHasSelection",
        "args": {
            "snippet": "$${TM_SELECTED_TEXT}$1$"
        }
    },
    {
        "key": "ctrl+alt+m",
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown' && editorHasSelection",
        "args": {
            "snippet": "$$\n${TM_SELECTED_TEXT}$1\n$$"
        }
    },
    {
        "key": "shift+alt+8", // MARK: Parentheses
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\left(${TM_SELECTED_TEXT}$1\\right)$0"
        }
    },
    {
        "key": "ctrl+l shift+8", // Parentheses
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\left(${TM_SELECTED_TEXT}$1\\right)$0"
        }
    },
    {
        "key": "shift+alt+7", // MARK: Fractions
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\frac{${TM_SELECTED_TEXT}$1}{$2}$0"
        }
    },
    {
        "key": "ctrl+l f", // Fractions
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\frac{${TM_SELECTED_TEXT}$1}{$2}$0"
        }
    },
    {
        "key": "ctrl+l v", // MARK: Vec
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\vec{${TM_SELECTED_TEXT}$1}$0"
        }
    },
    {
        "key": "ctrl+l h", // MARK: Hat
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\hat{${TM_SELECTED_TEXT}$1}$0"
        }
    },
    {
        "key": "ctrl+l -", // MARK: Bar
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\bar{${TM_SELECTED_TEXT}$1}$0"
        }
    },
    {
        "key": "ctrl+l b", // MARK: Boxed
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\boxed{${TM_SELECTED_TEXT}$1}$0"
        }
    },
    {
        "key": "ctrl+l s", // MARK: Square Root
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\sqrt{${TM_SELECTED_TEXT}$1}$0"
        }
    },
    {
        "key": "ctrl+l t", // MARK: Text
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\text{${TM_SELECTED_TEXT}$1}$0"
        }
    },
    {
        "key": "ctrl+l a", // MARK: Aligned
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "\\begin{aligned}\n${TM_SELECTED_TEXT}$0\n\\end{aligned}"
        }
    },
    {
        "key": "ctrl+l e", // MARK: Exponent (10^)
        "command": "editor.action.insertSnippet",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'markdown'",
        "args": {
            "snippet": "⋅10^{$1}$0"
        }
    },

    // #endregion
    {
        "key": "shift+alt+enter",
        "command": "github.copilot.generate",
        "when": "editorTextFocus && github.copilot.activated"
    },
    {
        "key": "ctrl+enter",
        "command": "-github.copilot.generate",
