    },
    {
        "key": "ctrl+shift+alt+c",
        "command": "-better-markdown-latex-shortcuts.alignedEnviromen",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+a",
        "command": "better-markdown-latex-shortcuts.alignedEnviromen"
    },
    {
        "key": "ctrl+shift+d",
        "command": "workbench.view.debug",
